/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/*.woff2
  Content-Type: font/woff2
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/*.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/*.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.avif
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.yaml
  Content-Type: application/yaml; charset=utf-8

/*.yml
  Content-Type: application/yaml; charset=utf-8

/*.tgz
  Content-Type: application/octet-stream
  X-Content-Type-Options: nosniff

/packages/npm/@kitsos/:package/v:version/*
  Cache-Control: public, max-age=31536000, immutable

/api/:service/openapi.yaml
  Cache-Control: no-store, max-age=0, must-revalidate

/api/:service/openapi-:version.yaml
  Cache-Control: public, max-age=31536000, immutable

/404.html
  Cache-Control: no-store
  Content-Type: text/html; charset=utf-8

/health/asset-probe.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

/health/cdn-probe-v2.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800
  Timing-Allow-Origin: *
  Access-Control-Expose-Headers: CF-Ray, CF-Cache-Status, Age, Server-Timing
  X-Content-Type-Options: nosniff
