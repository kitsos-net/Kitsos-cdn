{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "_headers",
      "_redirects"
    ],
    "redirects": [
      {
        "source": "/api/keys/latest/openapi.yaml",
        "destination": "/api/keys/openapi.yaml?latest",
        "type": 302
      },
      {
        "source": "/api/keys-admin/latest/openapi.yaml",
        "destination": "/api/keys-admin/openapi.yaml?latest",
        "type": 302
      },
      {
        "source": "/api/mail/latest/openapi.yaml",
        "destination": "/api/mail/openapi.yaml?latest",
        "type": 302
      },
      {
        "source": "/api/verify/latest/openapi.yaml",
        "destination": "/api/verify/openapi.yaml?latest",
        "type": 302
      },
      {
        "source": "/api/hme/latest/openapi.yaml",
        "destination": "/api/hme/openapi.yaml?latest",
        "type": 302
      },
      {
        "source": "/api/dns-hosting/latest/openapi.yaml",
        "destination": "/api/dns-hosting/openapi.yaml?latest",
        "type": 302
      },
      {
        "source": "/api/utility/latest/openapi.yaml",
        "destination": "/api/utility/openapi.yaml?latest",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**/*.woff2",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/*.@(svg|png|webp|avif|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/api/*/openapi.yaml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/api/*/latest/openapi.yaml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/api/*/openapi-*.yaml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/404.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/health/asset-probe.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ]
  }
}
